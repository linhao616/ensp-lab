# eNSP Lab 子项目忽略规则

# 编译产物（根锚定：仅忽略根目录二进制，避免误伤 cmd/server/ 等目录）
*.exe
*.exe~
*.dll
*.so
*.dylib
/ensp-lab
/server

# 调试截图与临时图片
screenshot_*.png
*.tmp.png

# 前端构建产物（由 frontend/ build 产生）
web/dist/
frontend/dist/
frontend/node_modules/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# 前端环境
.env.local
.env.*.local

# Go 测试与覆盖
*.test
*.out
coverage.html
coverage.txt

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 本地数据
data/*.local.json
# 运行时拓扑（服务 autosave 生成，非源码；样例 lab*.json 为只读入库，改动走
# git update-index --assume-unchanged 隐藏，避免 autosave 换行写回导致 /version stale）
data/*.json

# WorkBuddy 项目笔记（本地开发环境，不提交）
.workbuddy/

# WorkBuddy 结果展示副本（截图/报告，仅本地）
outputs/

# 临时测试/验证产物（保留 tmp/*.py 脚本）
tmp/*.log
tmp/lowres-main
tmp/*.csv
tmp/*.json
tmp/vxlan-data/
tmp/cmdline.txt
tmp/ensp-smoke*/
tmp/ensp-smoke*/**
# e2e 浏览器复验运行时数据（-data-dir ./tmp/e2e-data 生成，非源码）
tmp/e2e-data/
# CI 日志下载/解压产物（ci-verify 脚本临时落地）
tmp/ci-logs/
tmp/ci-logs.zip
tmp/logs2/
tmp/logs2.zip
tmp/dl-ci-logs.js
tmp/dl2.js
# npm 构建日志（PowerShell 重定向产物）
frontend/npm-install.log
# 本地开发目录（dev/ 非源码）
dev/
