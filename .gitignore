# eNSP Lab 子项目忽略规则

# 编译产物（根锚定：仅忽略根目录二进制，避免误伤 cmd/server/ 等目录）
*.exe
*.exe~
*.dll
*.so
*.dylib
/ensp-lab
/server

# 调试截图与临时图片
screenshot_*.png
*.tmp.png

# 前端构建产物（由 frontend/ build 产生）
web/dist/
frontend/dist/
frontend/node_modules/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

# 前端环境
.env.local
.env.*.local

# Go 测试与覆盖
*.test
*.out
coverage.html
coverage.txt

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 本地数据
data/*.local.json

# WorkBuddy 项目笔记（本地开发环境，不提交）
.workbuddy/

# WorkBuddy 结果展示副本（截图/报告，仅本地）
outputs/

# 临时测试/验证产物（保留 tmp/*.py 脚本）
tmp/*.log
tmp/lowres-main
tmp/*.csv
tmp/*.json
tmp/vxlan-data/
tmp/cmdline.txt
tmp/ensp-smoke*/
tmp/ensp-smoke*/**
